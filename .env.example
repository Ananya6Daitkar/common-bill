# Copy to .env.local. Never commit API keys.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Set after choosing your provider: groq | openai | gemini | anthropic
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Required before exposing paid API routes publicly.
COMMON_BILL_ACCESS_TOKEN=

# Enable the fixed public live scenarios (uses provider quota).
PUBLIC_DEMO_ENABLED=false
